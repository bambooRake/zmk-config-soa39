#include "soa39.dtsi"
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/input/input-event-codes.h>
#include <input/processors.dtsi>

&default_transform {
    col-offset = <5>;
};

&kscan0 {
        col-gpios
            = <&xiao_d 10 GPIO_ACTIVE_HIGH>
            , <&xiao_d 9 GPIO_ACTIVE_HIGH>
            , <&xiao_d 8 GPIO_ACTIVE_HIGH>
            , <&xiao_d 7 GPIO_ACTIVE_HIGH>
            , <&gpio0 10 GPIO_ACTIVE_HIGH>
            ;
};

/ {
    xy_clipper: xy_clipper {
        compatible = "zmk,input-processor-xy-clipper";
        #input-processor-cells = <0>;
        threshold = <20>;
        invert-x = <0>;
        invert-y = <0>;
    };

    // iOS風 慣性スクロール (mjmjm0101/zmk-input-processor-scroll-inertia)
    // 縦(Y)のみ。SCROLLレイヤー(5)専用。scale/scale-div は下流の
    // zip_scroll_scaler 2 5 に合わせる (慣性出力と実スクロールの整合)。
    scroll_inertia_v: scroll_inertia_v {
        compatible = "zmk,input-processor-scroll-inertia";
        #input-processor-cells = <0>;
        axis = <1>;       // 0=両軸, 1=Y(縦)のみ, 2=X(横)のみ
        layer = <5>;      // SCROLLレイヤー。層OFFで内部状態を即リセット
        scale = <2>;      // 下流 zip_scroll_scaler 2 5 に合わせる
        scale-div = <5>;

        // --- 62.5Hz(16ms)/CPI600 向けチューニング ---
        // 既定は 1000CPI/125Hz(8ms)前提。作者の 125Hz→250Hz 値の振り方を
        // 62.5Hz へ外挿(レート半分: tick倍/min-events半分/friction倍/decay→より減衰)。
        tick = <16>;           // 62.5Hz = 16ms (既定8=125Hz)
        min-events = <5>;      // 既定10。160ms→80msで発動許可(全く発動しない主因)
        start = <25>;          // 既定40。まず確実に発動させる方向へ下げる
        move = <45>;           // 既定80。同上
        decel-samples = <2>;   // 既定3。低レートで減速確定を早める
        suppress-limit = <25>; // 既定50。レート半分に合わせ半分
        decay-fast = <980>;    // 既定990。tick少で同じ体感tail長にするため強め
        decay-slow = <980>;
        decay-tail = <980>;
        peak-decay = <980>;    // 既定990
        friction = <70>;       // 既定35。per-tickなのでtick倍に合わせ倍
    };

    trackball_listener {
        status = "okay";
        compatible = "zmk,input-listener";
        device = <&trackball>;
        // Auto mouse layer: トラックボール操作時にレイヤを 700ms 一時 active 化
        // 数字はレイヤ index (例: 2 = MOUSE レイヤ)
        // input-processors = <&zip_temp_layer 2 700>;

        scroller {
            layers = <5>;
            input-processors =
                <&xy_clipper>,
                <&zip_xy_to_scroll_mapper>,
                <&zip_scroll_transform (INPUT_TRANSFORM_Y_INVERT)>,
                <&scroll_inertia_v>,
                <&zip_scroll_scaler 2 5>;
        };
    };
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
            low-power-enable;
        };
    };

    spi1_default: spi1_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
                <NRF_PSEL(SPIM_MOSI, 0, 19)>,
                <NRF_PSEL(SPIM_MISO, 0, 19)>;
        };
    };

    spi1_sleep: spi1_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
                <NRF_PSEL(SPIM_MOSI, 0, 19)>,
                <NRF_PSEL(SPIM_MISO, 0, 19)>;
            low-power-enable;
        };
    };
};

// Override led_strip to set red color for right side  
&led_strip {
    status = "okay";
    chain-length = <1>;
    // Pre-set WS2812 to red color (0xFF0000) for right side identification
};

&xiao_serial { status = "disabled"; };

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610-alt";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio1 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        evt-type = <2>;  // INPUT_EV_REL
        x-input-code = <0>;  // INPUT_REL_X
        y-input-code = <1>;  // INPUT_REL_Y
        cpi = <600>;  // 感度。範囲200-3200/200刻み。物理(ピント)調整後、元の 600 に戻して確定
        swap-xy;
        // force-awake 削除: idle/active切替のたびに PERFORMANCE レジスタが
        // 書き換わり、それがカーソルジッター(モード変化時のブレ)のトリガーに
        // なっていたため。ハード側の RUN/REST 自動ダウンシフトに任せる方が
        // 省電力にも有利。
        wakeup-source;
    };
};

