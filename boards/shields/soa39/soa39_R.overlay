#include "soa39.dtsi"
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/input/input-event-codes.h>
#include <input/processors.dtsi>
#include <behaviors/input_gestures_accel.dtsi>

&default_transform {
    col-offset = <5>;
};

&kscan0 {
        col-gpios
            = <&xiao_d 10 GPIO_ACTIVE_HIGH>
            , <&xiao_d 9 GPIO_ACTIVE_HIGH>
            , <&xiao_d 8 GPIO_ACTIVE_HIGH>
            , <&xiao_d 7 GPIO_ACTIVE_HIGH>
            , <&gpio0 10 GPIO_ACTIVE_HIGH>
            ;
};

// カーソル加速 (oleksandrmaslov/zmk-pointing-acceleration)
// ボールをゆっくり回した時は素の CPI=400 で精密に、速く弾いた時だけ
// 倍率を上げて一気に飛ばす。スクロールレイヤ(5)には掛からない
// (下の scroller 子ノードがマッチすると base の input-processors はスキップされるため)。
//
// 速度の目安 (CPI=400 / レポート間隔 16ms=62.5Hz、軸ごとに独立計算):
//   cps(counts/sec) = |1レポートの移動量| x 62.5 ≒ 400 x 物理速度[inch/s]
//     1.0 inch/s -> cps  400
//     5.0 inch/s -> cps 2000
//     7.5 inch/s -> cps 3000
&pointer_accel {
    input-type = <INPUT_EV_REL>;

    // 低速側は等倍 (CPI を 400 まで落としてあるのでこれ以上減速させない)
    min-factor = <1000>;          // 1.000x
    // 高速側の最大倍率。実効 400 x 3.5 = 1400 CPI 相当
    max-factor = <3500>;          // 3.500x

    // ここ以下は等倍のまま = 精密操作域 (~1.0 inch/s)
    speed-threshold = <400>;
    // ここで max-factor に到達 (~7.5 inch/s)
    speed-max = <3000>;

    // 2 = 二次カーブ。閾値直後は緩やかに効き、速度が乗ってから一気に伸びる
    // (1=リニアだと中速域が過敏になりやすい)
    acceleration-exponent = <2>;

    // 端数(1未満の移動量)を蓄積して次レポートに繰り越す。
    // 低 CPI では切り捨て損失が効くので必須
    track-remainders;
};

/ {
    xy_clipper: xy_clipper {
        compatible = "zmk,input-processor-xy-clipper";
        #input-processor-cells = <0>;
        threshold = <20>;
        invert-x = <0>;
        invert-y = <0>;
    };

    trackball_listener {
        status = "okay";
        compatible = "zmk,input-listener";
        device = <&trackball>;
        // Auto mouse layer: トラックボール操作時にレイヤを 700ms 一時 active 化
        // 数字はレイヤ index (例: 2 = MOUSE レイヤ)
        // input-processors = <&zip_temp_layer 2 700>;

        // カーソル移動時の加速。scroller (layer 5) がマッチしている間は
        // この base 側はスキップされるので、スクロールには影響しない
        input-processors = <&pointer_accel>;

        scroller {
            layers = <5>;
            input-processors =
                <&xy_clipper>,
                <&zip_xy_to_scroll_mapper>,
                <&zip_scroll_transform (INPUT_TRANSFORM_Y_INVERT)>,
                <&zip_scroll_scaler 2 5>;
        };
    };
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
            low-power-enable;
        };
    };

    spi1_default: spi1_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
                <NRF_PSEL(SPIM_MOSI, 0, 19)>,
                <NRF_PSEL(SPIM_MISO, 0, 19)>;
        };
    };

    spi1_sleep: spi1_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
                <NRF_PSEL(SPIM_MOSI, 0, 19)>,
                <NRF_PSEL(SPIM_MISO, 0, 19)>;
            low-power-enable;
        };
    };
};

// Override led_strip to set red color for right side  
&led_strip {
    status = "okay";
    chain-length = <1>;
    // Pre-set WS2812 to red color (0xFF0000) for right side identification
};

&xiao_serial { status = "disabled"; };

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610-alt";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio1 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        evt-type = <2>;  // INPUT_EV_REL
        x-input-code = <0>;  // INPUT_REL_X
        y-input-code = <1>;  // INPUT_REL_Y
        // 600 -> 400: 低速時の精度を稼ぐ。速い時の飛びは &pointer_accel で補う
        cpi = <400>;
        swap-xy;
        force-awake;
        wakeup-source;
    };
};

