DT_COMPAT_ZMK_INPUT_PROCESSOR_POINTER_INERTIA := zmk,input-processor-pointer-inertia

config ZMK_INPUT_PROCESSOR_POINTER_INERTIA
    bool "Pointer (cursor) inertia / coasting input processor"
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_INPUT_PROCESSOR_POINTER_INERTIA))
    depends on ZMK_POINTING
    depends on INPUT
    help
      ボールを速く動かして止めた直後、カーソルを減衰させながら少しだけ
      滑らせる入力プロセッサ。ゆっくり動かしている間は発動しない。

config ZMK_INPUT_PROCESSOR_POINTER_INERTIA_INIT_PRIORITY
    int "Pointer inertia input processor init priority"
    depends on ZMK_INPUT_PROCESSOR_POINTER_INERTIA
    default 90
